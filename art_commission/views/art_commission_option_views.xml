<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="art_commission_option_list" model="ir.ui.view">
        <field name="name">art.commission.option.list</field>
        <field name="model">art.commission.option</field>
        <field name="arch" type="xml">
            <list string="Commission Options">
                <field name="name"/>
                <field name="description"/>
                <field name="extra_price"/>
            </list>
        </field>
    </record>
    <record id="art_commission_option_action" model="ir.actions.act_window">
        <field name="name">Art Commission Option</field>
        <field name="res_model">art.commission.option</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
